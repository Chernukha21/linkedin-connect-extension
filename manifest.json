{
  "manifest_version": 3,
  "name": "LinkedIn Connect Automation",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "debugger",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}