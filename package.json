{
  "name": "linkedin-connect-extension",
  "version": "1.0.0",
  "description": "Chrome MV3 extension for LinkedIn connection automation",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,html,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\" \"*.{json,md}\"",
    "test": "node --test",
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "linkedin"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "prettier": "^3.9.6"
  }
}
